---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---

<Layout
  title="Javier Campos Moñino | Senior Full Stack Developer"
  description="Desarrollador senior en Madrid con más de 10 años de experiencia en Angular, React y Next.js. IA aplicada, pagos con Stripe e infraestructura con Terraform."
>
  <Header />
  <main id="contenido">
    <Hero />
    <Experience />
    <Skills />
    <Projects />
    <Education />
    <Contact />
  </main>
  <footer class="mx-auto max-w-5xl px-5 py-8 text-sm text-muted">
    © {new Date().getFullYear()} Javier Campos Moñino. Hecho con Astro y Tailwind CSS.
  </footer>
</Layout>
