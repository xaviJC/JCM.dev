---
import JobRow from './JobRow.astro';
import { recentJobs, earlierJobs } from '../data/cv';
---

<section id="experiencia" class="mx-auto max-w-5xl px-5 py-14 md:py-20">
  <h2 class="font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">Experiencia</h2>

  <ol class="mt-8">
    {recentJobs.map((job) => <JobRow job={job} />)}
  </ol>

  <details class="border-y border-line">
    <summary class="flex items-center justify-between gap-4 py-6 font-display text-lg font-semibold text-ink hover:text-brand">
      <span>2014 – 2018: SAP ABAP y primeros proyectos web</span>
      <svg class="chevron h-5 w-5 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </summary>
    <ol>
      {earlierJobs.map((job) => <JobRow job={job} />)}
    </ol>
  </details>
</section>
