---
import { profile } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const navItems = [
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Tecnologías', href: '#tecnologias' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Formación', href: '#formacion' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/90 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3" aria-label="Principal">
    <a href={base} class="font-display text-lg font-bold tracking-tight text-ink">Javier Campos</a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-muted transition-colors hover:text-brand">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={`${base}${profile.cvFile}`}
        download={profile.cvDownloadName}
        class="hidden rounded-md bg-brand px-3 py-1.5 text-sm font-semibold text-bg sm:inline-block"
      >
        Descargar CV
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md border border-line p-2 text-muted hover:text-brand"
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-line p-2 text-muted hover:text-brand md:hidden"
        aria-label="Abrir o cerrar el menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg md:hidden">
    <ul class="mx-auto max-w-5xl px-5 py-2">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="block py-3 text-base text-ink">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={`${base}${profile.cvFile}`} download={profile.cvDownloadName} class="block py-3 text-base font-semibold text-brand">
          Descargar CV (PDF)
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const themeButton = document.getElementById('theme-toggle');
  themeButton?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {
      // Sin almacenamiento disponible: el tema vale solo para esta visita.
    }
  });

  const menuButton = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    menuButton?.setAttribute('aria-expanded', String(open));
  };
  menuButton?.addEventListener('click', () => setMenu(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
</script>
