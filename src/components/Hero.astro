---
import { profile } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<section class="mx-auto max-w-5xl px-5 pb-16 pt-28 md:pb-24 md:pt-40">
  <h1 class="font-display text-[clamp(2.75rem,9vw,6.5rem)] font-extrabold leading-[0.95] tracking-tight text-ink">
    Javier Campos Moñino
  </h1>
  <p class="mt-6 font-display text-xl font-semibold text-brand md:text-2xl">
    {profile.role}, {profile.location}
  </p>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink md:text-xl">
    Construyo productos web completos, de la interfaz a los pagos y la infraestructura. Más de 10 años con Angular,
    React y Next.js, y en los últimos con IA aplicada: agentes, asistentes de compra y testing E2E.
  </p>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
    Ahora en Fusuma, trabajando en Mutua Pets, Mutua Home y Pleiful.
  </p>
  <div class="mt-9 flex flex-col gap-3 sm:flex-row">
    <a
      href={`${base}${profile.cvFile}`}
      download={profile.cvDownloadName}
      class="rounded-md bg-brand px-6 py-3 text-center font-semibold text-bg"
    >
      Descargar CV (PDF)
    </a>
    <a
      href="#contacto"
      class="rounded-md border border-line px-6 py-3 text-center font-semibold text-ink hover:border-brand hover:text-brand"
    >
      Contactar
    </a>
  </div>
</section>
